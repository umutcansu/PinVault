<?xml version="1.0" encoding="utf-8"?>
<!--
  audit L-11 / security review A-2: no cleartext anywhere in a release build.
  The library's pinned HTTPS Config API endpoints are unaffected. Connection
  reports go to the pinned TLS Config API (BaseDemoActivity.sendReport).

  The DEBUG build replaces this file (src/debug/res/xml/network_security_config.xml)
  and permits cleartext for the lab hosts only, because its reports still go
  to the demo-server's plain-HTTP management port (8090).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
