<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- audit L-11: cleartext is no longer permitted app-wide. The only
         plaintext path is the demo management/report endpoint (port 8090);
         network_security_config scopes cleartext to the lab hosts only. -->
    <application
        android:allowBackup="false"
        android:label="PinVault Demo"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.PinVaultDemo">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".TlsToTlsActivity" />
        <activity android:name=".TlsToMtlsActivity" />
        <activity android:name=".MtlsToTlsActivity" />
        <activity android:name=".MtlsToMtlsActivity" />
        <activity android:name=".VaultFileDemoActivity" />
        <activity android:name=".VaultSecurityDemoActivity" />

    </application>
</manifest>
