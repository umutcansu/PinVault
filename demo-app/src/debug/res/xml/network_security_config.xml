<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILD ONLY — overrides src/main/res/xml/network_security_config.xml.

  audit L-11: deny cleartext by default. The library's pinned HTTPS Config API
  endpoints are unaffected. The debug demo's management/report endpoint
  (port 8090) is the only plaintext path, so cleartext is permitted ONLY for
  the lab hosts (the LAN server IP and the emulator loopback alias). Adjust
  these to match your own lab. A release build never carries this file
  (security review A-2): it reports over the pinned TLS Config API instead.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.1.80</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
