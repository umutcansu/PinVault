# ── Secrets and key material ────────────────────────────────────────────────
# The README's Docker quick start puts the signing key, the CA keystores and
# the database under demo-server/data/ ({db,certs,keys}). None of it may ever
# be committed: this repository mirrors to a public one.
demo-server/data/
**/signing-key*.pem

# Safety net, repository-wide: keystores, PKCS#12 bundles, PEM/DER keys and
# databases are never source. Nothing tracked matches these patterns today
# (git ls-files); if a file of one of these types must be tracked — a public
# test certificate, say — add an explicit exception right below this block:
#     !path/to/public-test-cert.pem
# and make sure sample-host/scripts/check-secrets.sh still passes.
*.jks
*.p12
*.pfx
*.bks
*.keystore
*.pem
*.key
*.der
*.p8
key.properties
keystore.properties
*.db
*.sqlite
*.sqlite3
# Public certificates the server ships as resources (no private key).
!demo-server/src/main/resources/attestation/google-hardware-attestation-roots.pem
# iOS library test fixtures: the public certificates of the DER/SPKI/X509 tests
# are tracked (listed in .secrets-allow); the throwaway test KEYS are not —
# pinvault-ios/scripts/generate-test-keys.sh makes them in every checkout
# (Fixtures/README.md).
!pinvault-ios/Tests/PinVaultTests/Fixtures/*.der
!pinvault-ios/Tests/PinVaultTests/Fixtures/*.pem
pinvault-ios/Tests/PinVaultTests/Fixtures/tls/*
!pinvault-ios/Tests/PinVaultTests/Fixtures/tls/generate.sh
pinvault-ios/Tests/PinVaultTests/Fixtures/vault/ios-device-key.*
pinvault-ios/Tests/PinVaultTests/Fixtures/vault/server-*.envelope.bin

# Offline keys, generated env files and moved-aside demo installs (sample-host)
offline-keys/
.env
.env.*
!.env.example
!.env.production.example
backup-before-production-*/

# Internal comparison document; not part of the project
/MASC-vs-PinVault-DexProtector.pdf

# SwiftPM / Xcode (iOS library and sample)
.build/
.swiftpm/
xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
DerivedData/

# Session-only audit reports
.local-reports/

# JVM heap dumps (an out-of-memory build leaves one in the project root)
*.hprof
