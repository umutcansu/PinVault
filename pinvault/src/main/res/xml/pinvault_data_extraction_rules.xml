<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) icin veri cikarma kurallari.
  PinVault'un telefonda sakladiklari yedege ve cihaz transferine girmez:
  sifreleme anahtarlari Android Keystore'da durur, baska cihazda cozulemez;
  eski bir yedegi geri yuklemek de eski bir pin config'ini ya da iptal
  edilmis bir imza anahtarini geri getirirdi (M-07).

  Her depo turu tek bir dosyada (pinvault_secure_*.xml): butun Config API
  bloklari, kimlikleri ne olursa olsun, bu kurallarin kapsamindadir.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="pinvault_secure_config.xml" />
        <exclude domain="sharedpref" path="pinvault_secure_client_cert.xml" />
        <exclude domain="sharedpref" path="pinvault_secure_signing_keys.xml" />
        <exclude domain="sharedpref" path="pinvault_secure_vault_files.xml" />
        <exclude domain="sharedpref" path="pinvault_vault_file_versions.xml" />
        <exclude domain="file" path="vault_files" />
        <!--
          PinVault 2.0.x dosyalari (EncryptedSharedPreferences). Guncellemeden
          sonraki ilk acilista yeni dosyalara tasinip silinirler; o ana kadar
          yedege girmesinler. Kendi kimliginizle acilmis eski bir blok dosyasi
          (ssl_cert_config_<id>.xml) burada yoktur ama o da ilk acilista tasinir.
        -->
        <exclude domain="sharedpref" path="pinvault_client_cert.xml" />
        <exclude domain="sharedpref" path="ssl_cert_config.xml" />
        <exclude domain="sharedpref" path="ssl_cert_config_default.xml" />
        <exclude domain="sharedpref" path="ssl_cert_config_default-tls.xml" />
        <exclude domain="sharedpref" path="ssl_cert_config_secure-mtls.xml" />
        <exclude domain="sharedpref" path="pinvault_signing_keys.xml" />
        <exclude domain="sharedpref" path="pinvault_vault_files.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="pinvault_secure_config.xml" />
        <exclude domain="sharedpref" path="pinvault_secure_client_cert.xml" />
        <exclude domain="sharedpref" path="pinvault_secure_signing_keys.xml" />
        <exclude domain="sharedpref" path="pinvault_secure_vault_files.xml" />
        <exclude domain="sharedpref" path="pinvault_vault_file_versions.xml" />
        <exclude domain="file" path="vault_files" />
        <exclude domain="sharedpref" path="pinvault_client_cert.xml" />
        <exclude domain="sharedpref" path="ssl_cert_config.xml" />
        <exclude domain="sharedpref" path="ssl_cert_config_default.xml" />
        <exclude domain="sharedpref" path="ssl_cert_config_default-tls.xml" />
        <exclude domain="sharedpref" path="ssl_cert_config_secure-mtls.xml" />
        <exclude domain="sharedpref" path="pinvault_signing_keys.xml" />
        <exclude domain="sharedpref" path="pinvault_vault_files.xml" />
    </device-transfer>
</data-extraction-rules>
