{
  "name": "@umutcansu/react-native-pinvault",
  "version": "2.4.0",
  "description": "PinVault for React Native: dynamic certificate pinning with signed remote configs, mTLS enrollment and signed vault files, as a thin bridge over the native PinVault libraries",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "pinvault-source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android/build.gradle",
    "android/consumer-rules.pro",
    "android/src/main",
    "ios/*.h",
    "ios/*.mm",
    "ios/*.swift",
    "ios/Core",
    "*.podspec",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!**/__tests__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "prepare": "bob build",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "clean": "rm -rf lib android/build"
  },
  "keywords": [
    "react-native",
    "certificate-pinning",
    "ssl-pinning",
    "mtls",
    "security",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umutcansu/PinVault.git",
    "directory": "pinvault-react-native"
  },
  "author": "Umut Cansu <umutcansu@gmail.com> (https://github.com/umutcansu)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/umutcansu/PinVault/issues"
  },
  "homepage": "https://github.com/umutcansu/PinVault/tree/main/pinvault-react-native#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.81.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-builder-bob": "^0.43.1",
    "typescript": "^6.0.3"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RNPinVaultSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "io.github.umutcansu.pinvault.reactnative"
    },
    "ios": {
      "modules": {
        "RNPinVault": {
          "className": "RNPinVault"
        }
      },
      "modulesConformingToProtocol": {
        "RCTURLRequestHandler": [
          "RNPinVaultURLRequestHandler"
        ]
      }
    }
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "testEnvironmentOptions": {
      "customExportConditions": [
        "require",
        "react-native",
        "pinvault-source"
      ]
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/lib/"
    ]
  }
}
