<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_mode_title"
            android:textStyle="bold"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <RadioButton
                android:id="@+id/modeTls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mode_tls" />

            <RadioButton
                android:id="@+id/modeMtlsConfig"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mode_mtls_config" />

            <RadioButton
                android:id="@+id/modeCustomBackend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mode_custom_backend" />

            <RadioButton
                android:id="@+id/modeEmbeddedApi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mode_embedded_api" />

            <RadioButton
                android:id="@+id/modeStatic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mode_static" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_telemetry_title"
            android:textStyle="bold"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/reportSuccessCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_report_success" />

        <CheckBox
            android:id="@+id/scopedPinsCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_scoped_pins" />

        <EditText
            android:id="@+id/dedupMsInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_dedup_hint"
            android:importantForAutofill="no"
            android:inputType="number"
            android:singleLine="true" />

        <Button
            android:id="@+id/applyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_apply"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_advanced_title"
            android:textStyle="bold"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/settingsClientButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="@string/settings_client_test" />

            <Button
                android:id="@+id/resetButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/settings_reset" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/reinitButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="@string/settings_reinit" />

            <Button
                android:id="@+id/restartButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/settings_restart" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/workInfoButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="@string/settings_work_info" />

            <Button
                android:id="@+id/cancelWorkButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:text="@string/settings_work_cancel" />

            <Button
                android:id="@+id/scheduleWorkButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/settings_work_schedule" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:padding="14dp"
            android:background="#22000000"
            android:textIsSelectable="true"
            android:minLines="5" />
    </LinearLayout>
</ScrollView>
