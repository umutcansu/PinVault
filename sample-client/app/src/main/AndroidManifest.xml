<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Düz HTTP her yerde kapalı (network_security_config.xml).

      Yedek ve cihaz taşıma: allowBackup="false" Android 12+'da cihazdan cihaza
      taşımayı kapatmaz. Kütüphanenin kuralları manifest birleştirmeyle gelir;
      örnek kendi dosyalarını (elle yüklenen sertifika) da dışarıda tutmak için
      onların yerine kendi kural dosyalarını koyar. Bu dosyalar kütüphanenin
      bütün kurallarını aynen içerir.

      taskAffinity="": ekranlar paket adına bağlı bir göreve (task) katılmaz.
      Aynı affinity'yi ilan eden başka bir uygulama kendi ekranını bu uygulamanın
      görevine sokup onun yerine görünemez (task hijacking / StrandHogg).
    -->
    <application
        android:name=".App"
        android:taskAffinity=""
        android:allowBackup="false"
        android:dataExtractionRules="@xml/sample_data_extraction_rules"
        android:fullBackupContent="@xml/sample_backup_rules"
        tools:replace="android:dataExtractionRules,android:fullBackupContent"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.SampleClient">

        <!--
          Tek dışa açık bileşen: başlatıcı. Dışarıdan gelen intent eklerini
          okumaz; `mode` eki yalnızca test derlemelerinde (TestControls) okunur.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MtlsActivity"
            android:exported="false"
            android:label="@string/mtls_title" />

        <activity
            android:name=".VaultActivity"
            android:exported="false"
            android:label="@string/vault_title" />

        <!--
          Ayarlar ve Depolama ekranları test kontrolleridir; yalnızca debug ve e2e
          derlemelerinin manifest'ine girer (src/testControls/AndroidManifest.xml).
        -->
    </application>
</manifest>
