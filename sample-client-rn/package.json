{
  "name": "sample-client-rn",
  "version": "1.0.0",
  "private": true,
  "description": "PinVault React Native örnek uygulaması (sample-host'a karşı)",
  "scripts": {
    "gen": "node scripts/gen-host-config.js",
    "start": "node scripts/gen-host-config.js && react-native start",
    "android": "node scripts/gen-host-config.js && react-native run-android",
    "ios": "node scripts/gen-host-config.js && react-native run-ios",
    "typecheck": "node scripts/gen-host-config.js && tsc --noEmit"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.87.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/react": "^19.2.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
