# sample-e2e — iOS koşusunun ayarları (E2E_PLATFORM=ios).
#
#   cp .env.ios.example .env.ios      # git dışı; lib/env.js iOS koşusunda okur
#   npm run test:ios
#
# Ortamda zaten verilmiş bir değişkeni .env.ios ezmez. Aynı Mac'te başka bir
# oturum Android koşusu yapıyorsa (host 6650–6656, vekil 6661, geçici test
# sunucusu 6750–6756) iOS koşusu buradaki ayrı portları ve ayrı host'u kullanır.

# Simülatör: yalnızca bu koşuya ayrılmış olmalı (uygulama verisi ve Keychain silinir).
E2E_IOS_UDID=1D7D6D18-E5B5-4997-A5BD-459A4A2DFB62
# UI sürücüsü (ios-driver, XCUITest) — 127.0.0.1
E2E_IOS_DRIVER_PORT=6870

# Host: bu çalışma kopyasının sample-host'u (sample-e2e'ye göre). Onun .env'i
# COMPOSE_PROJECT_NAME=pinvault-ios, HOST_CONTAINER_NAME=pinvault-host-ios ve
# 6850–6856 portlarını taşır (SETUP.md → "iOS koşusu").
E2E_HOST_DIR=../sample-host
E2E_CONTAINER=pinvault-host-ios

# Harness'ın Mac'te açtığı servisler
E2E_CUSTOM_BACKEND_PORT=6860
E2E_PROXY_PORT=6861
E2E_WEBHOOK_PORT=6862
# iptables DROP karşılığı (bağlantıyı kabul edip yanıt vermeyen sunucu)
E2E_BLACKHOLE_PORT=6863

# Geçici test sunucusu (lib/freshHost.js): 6950–6956
E2E_FRESH_PORT_BASE=6950
E2E_FRESH_PROJECT=pinvault-ios-fresh
E2E_FRESH_CONTAINER=pinvault-host-ios-fresh

# İsteğe bağlı
# E2E_VARIANT=e2e                 # sample-client-ios E2E yapılandırması (Release optimizasyonu + test kontrolleri)
# E2E_IOS_CLIENT_DIR=../sample-client-ios
# E2E_IOS_APP_NAME=SampleClient   # derleme çıktısı <ad>.app
# E2E_IOS_DEVICE_ID=<uuid>        # uygulamanın identifierForVendor'u (report.json'dan okunur)
# E2E_IOS_DRIVER_WAIT_IDLE=1      # XCTest'in "uygulama boşta" beklemesini açık bırak
