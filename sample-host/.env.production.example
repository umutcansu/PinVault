# sample-host — ÜRETİM profili. ./scripts/setup.sh --production bu dosyadan .env
# üretir, verdiğin değerleri yazar ve boş bıraktığın gizli değerleri (API_KEY,
# KEYSTORE_PASSWORD, VAULT_AT_REST_PASSWORD, SIGNING_KEY_PASSWORD,
# CLIENT_P12_PASSWORD) rastgele doldurur.
#
# !!! Bu makinede ÇEVRİMDIŞI ÖZEL ANAHTAR ÜRETİLMEZ VE DURMAZ. Kurtarma ve yedek
# imza anahtarları başka (internete kapalı) bir makinede scripts/offline-keygen.sh
# ile üretilir; buraya yalnızca PUBLIC yarıları yazılır (RECOVERY_PUBLIC_KEYS,
# BACKUP_PUBLIC_KEYS). setup.sh --production ve sunucunun kendisi, bu dizinde özel
# bir çevrimdışı anahtar dosyası görürse durur.
#
# Önce bu dosyayı .env olarak kopyalayıp doldurabilir ya da değerleri setup.sh'a
# bayrak olarak verebilirsin (./scripts/setup.sh --help). Ayrıntı: README →
# "Üretim profili". Demo profilinden (.env.example) farkı "ÜRETİM:" ile işaretli.

# ÜRETİM: betikler ve sunucunun açılış kontrolü hangi profilde olduklarını buradan bilir.
SAMPLE_PROFILE=production
# ÜRETİM: compose iki dosyayı birlikte okur. İkincisi yönetim portlarını yalnızca
# bu makineye açar, mock host portlarını yayımlamaz, test anahtarlarını sabit
# kapatır ve container'ı sıkılaştırır. Docker Compose 2.24.4+ gerekir.
COMPOSE_FILE=docker-compose.yml:docker-compose.production.yml

# --- Port eşlemesi (container içi portlar sabit) ---
# ÜRETİM: iki yönetim portu da YALNIZCA bu makineye (127.0.0.1) açılır. Başka
# yerden yönetmek için VPN ya da SSH tüneli:
#   ssh -L 6655:127.0.0.1:6655 kullanici@sunucu   →   https://localhost:6655
HOST_HTTP_PORT=6650
HOST_HTTP_BIND=127.0.0.1
HOST_MANAGEMENT_TLS_PORT=6655
# Cihazların bağlandığı portlar (ağa açık):
HOST_HTTPS_PORT=6651
HOST_MTLS_PORT=6652
HOST_RECOVERY_PORT=6656
# ÜRETİM: mock hedef host portları (6653, 6654) yayımlanmaz.
# Container kaynak sınırları.
HOST_MEMORY_LIMIT=1g
HOST_PIDS_LIMIT=512

# --- Telefonların bu makineye ulaştığı IP ya da ad (boşsa setup.sh LAN IP'yi bulur) ---
HOST_LAN_IP=

# --- Paylaşılan yönetim anahtarı (setup.sh üretir) ---
# İki kişi onayı açıkken bu anahtar onay VEREMEZ; değişiklikleri kişisel
# yönetici anahtarlarıyla yap (ADMIN_KEYS).
API_KEY=

# --- demo-server kaynağı ---
# ÜRETİM: kaynak DEĞİŞMEZ olmalı. Dal ya da etiket adı (main, v2.1.1) zamanla başka
# bir kodu gösterebilir; setup.sh --production bunları reddeder. İkisinden biri:
#   PINVAULT_REF=<40 haneli commit SHA'sı>     (git rev-parse <etiket>^{commit})
#   PINVAULT_SERVER_SRC=../demo-server         (yerel, gözden geçirilmiş kaynak)
PINVAULT_REPO=https://github.com/umutcansu/PinVault.git
PINVAULT_REF=
# PINVAULT_SERVER_SRC=../demo-server

# --- Örnek uygulamanın hedefi ---
TARGET_HOST=www.example.com

# --- Sunucu davranışı ---
# ÜRETİM: yalnızca yöneticinin verdiği token ya da kayıt koduyla kayıt.
ENROLLMENT_MODE=token
CONFIG_TTL_SECONDS=86400

# ÜRETİM: sunucudaki yerel imza anahtarı (varsa) diskte AES-256-GCM ile şifreli
# (setup.sh üretir). Sunucu KEYSTORE_PASSWORD, VAULT_AT_REST_PASSWORD ve yerel
# imzalayıcı varken SIGNING_KEY_PASSWORD olmadan açılmaz.
SIGNING_KEY_PASSWORD=
# ÜRETİM: boş. Compose üretim dosyası "false" sabitler: sunucu hiçbir yoldan
# kaynak koddaki demo parolalarıyla açılmaz.
ALLOW_DEMO_SECRETS=
# ÜRETİM: boş. "URL'den sertifika al" yalnızca internetteki adreslere bağlanır;
# bu sunucunun kendisi ve yerel ağ (iç servisler) hedef olamaz. Yerel ağdaki bir
# host'u gerçekten pinlemen gerekiyorsa true yaz ve nedenini kaydet.
FETCH_ALLOW_PRIVATE_TARGETS=
ENROLLMENT_TOKEN_TTL_SECONDS=
VAULT_AT_REST_PASSWORD=
VAULT_AT_REST_PASSWORD_PREVIOUS=
CERT_EXPIRY_WARN_DAYS=
KEYSTORE_PASSWORD=
KEYSTORE_PASSWORD_PREVIOUS=
# ÜRETİM: varsayılan "changeit" kalmasın diye setup.sh rastgele üretir (P12 ile
# kayıt zaten kapalı: ENROLLMENT_P12=off).
CLIENT_P12_PASSWORD=
CLIENT_CERT_TTL_DAYS=

# --- İmzalayıcılar ---
# ÜRETİM: en az İKİ imzalayıcı ve en az biri sunucunun diskinde düz dosya DEĞİL.
# Tek ve diskteki bir anahtarla, sunucuyu ele geçiren herkes bütün telefonların
# kabul edeceği pin'leri imzalayabilir. setup.sh --production bu kuralı denetler,
# client-config.sh uygulamaya host.requiredSignatures=2 yazar.
#   CONFIG_SIGNERS=pkcs11,command   HSM + bulut KMS (önerilen)
#   CONFIG_SIGNERS=local,command    sunucudaki anahtar + KMS
#   CONFIG_SIGNERS=local,pkcs11     sunucudaki anahtar + HSM
# pkcs11 : PKCS11_LIBRARY = HSM üreticisinin PKCS#11 kitaplığının CONTAINER içindeki
#          yolu (imaja eklemen gerekir), PKCS11_PIN. SoftHSM gerçek HSM değildir
#          (anahtar yine bu diskte durur) ve bu kural için sayılmaz.
# command: SIGNER_COMMAND = stdin'den gelen baytları imzalayıp stdout'a imza basan
#          komut (KMS istemcisi imajda olmalı), SIGNER_PUBLIC_KEY = o anahtarın public
#          yarısı; özet imzalayan KMS'ler için SIGNER_INPUT=digest.
CONFIG_SIGNERS=
# HSM/KMS'e her cihaz isteğinde gidilmesin: aynı içerik bir kez imzalanır.
CONFIG_SIGNATURE_CACHE=true
PKCS11_LIBRARY=
PKCS11_SLOT_INDEX=
PKCS11_PIN=
PKCS11_KEY_LABEL=
PKCS11_GENERATE_KEY=
SIGNER_COMMAND=
SIGNER_PUBLIC_KEY=
SIGNER_PUBLIC_KEY_FILE=
SIGNER_INPUT=
SIGNER_TIMEOUT_MS=
# setup.sh yazar: uygulamanın her config'te isteyeceği imza sayısı (en az 2).
CLIENT_REQUIRED_SIGNATURES=2

# ÜRETİM: çevrimdışı anahtarların PUBLIC yarıları (Base64 X.509; virgülle birden
# çok). Özel yarıları bu makinede YOK. Başka makinede üret:
#   ./scripts/offline-keygen.sh keys recovery-1 backup-1
# Kurtarma anahtarı: sunucu yüklenen imzalama anahtarı setini bununla doğrular;
# uygulamaya da gömülür (çalınan imza anahtarını bütün telefonlarda iptal eder).
RECOVERY_PUBLIC_KEYS=
RECOVERY_REQUIRED_SIGNATURES=
# Yedek imza anahtarı: yalnızca uygulamaya gömülür (sunucu okumaz). Bir imzalayıcı
# kaybolursa uygulama güncellemesi olmadan bununla devam edilir.
BACKUP_PUBLIC_KEYS=

# ÜRETİM: kişisel yönetici anahtarları, ad:sha256 (en az iki). Her yönetici
# anahtarını kendi makinesinde üretir (offline-keygen.sh admin <ad>) ve yalnızca
# ad:sha256 değerini verir.
ADMIN_KEYS=
# ÜRETİM: pin, force, sertifika ve imza anahtarı değişikliği ikinci bir
# yöneticinin onayını bekler.
PIN_CHANGE_APPROVALS=2
APPROVAL_TTL_HOURS=
# Güvenlik olaylarını anında bir kanala gönder (Slack/Mattermost uyumlu). Önerilir.
NOTIFY_WEBHOOK_URL=
# Ayarlıysa imza "<X-PinVault-Timestamp>.<gövde>" üzerinden (HMAC-SHA256); alıcı
# eski zaman damgalı bildirimleri reddetmeli.
NOTIFY_WEBHOOK_SECRET=
NOTIFY_EVENTS=

# ÜRETİM: yeni pin seti, host'un şu an sunduğu sertifikayı tutmuyorsa kaydedilmez.
PIN_LIVE_CHECK=enforce
PIN_LIVE_CHECK_ALLOW_OVERRIDE=
# Sunucunun kendi içinden doğrudan çözemediği adlar (setup.sh host'un kendi
# IP'sini container içindeki Config API'ye yönlendirir).
LIVE_CHECK_HOST_MAP=

# ÜRETİM: ekran kilidiyle açılan dosyaların (user_auth) anahtarı, telefonun
# güvenli donanımında üretildiğini gösteren Google imzalı belge (Android Key
# Attestation) olmadan kabul edilmez; belge bu uygulamanın paket adını VE imza
# sertifikasını taşımalı. Emülatör yazılım belgesi üretir: bu profilde
# emülatörle user_auth denenmez.
USER_AUTH_ATTESTATION=enforce
ATTESTATION_PACKAGE_NAMES=com.example.sampleclient
# ZORUNLU: uygulamanın YAYIN imza sertifikasının SHA-256'sı (virgülle birden
# fazla; ':' olabilir). Boşsa sunucu enforce'ta AÇILMAZ: imza sabitlenmezse
# herhangi bir uygulama herhangi bir cihaz adına geçerli belge üretebilir.
# setup.sh --production boşsa sorar (ya da --attestation-signer <SHA-256>).
# Telefona kurulan SON dosyanın imzası olmalı (sample-client/README → "Yayın
# derlemesi"):
#   apksigner verify --print-certs app-release.apk | grep SHA-256
# Play App Signing kullanılıyorsa: Play Console → Uygulama bütünlüğü →
# Uygulama imzalama anahtarı sertifikası → SHA-256.
ATTESTATION_SIGNER_SHA256=
# ÜRETİM: kilidi açılmış (bootloader) ya da doğrulanmamış açılışlı telefonun belgesi geçmez.
ATTESTATION_REQUIRE_VERIFIED_BOOT=true
# ÜRETİM: Google'ın iptal ettiği donanım belgesi sertifikalarının listesi
# (container içindeki yol; host'ta data/attestation-status.json). Sunucu
# internete çıkmaz, listeyi bu dosyadan okur; dosya yoksa AÇILMAZ. İndir ve
# cron'a koy (README → "Donanım belgesi iptal listesi"):
#   ./scripts/fetch-attestation-status.sh
#   0 */6 * * *  cd /yol/sample-host && ./scripts/fetch-attestation-status.sh
ATTESTATION_REVOKED_SERIALS_FILE=/data/attestation-status.json
# ÜRETİM: liste 48 saatten eskiyse (indirme işi durmuşsa) hiçbir belge geçmez:
# o arada iptal edilen bir telefon fark edilmeden geçerdi.
ATTESTATION_STATUS_MAX_AGE_HOURS=48
# İsteğe bağlı: bu tarihten eski güvenlik yamalı telefonların belgesi geçmez (YYYYAA, ör. 202401).
ATTESTATION_MIN_PATCH_LEVEL=

# ÜRETİM: kayıtta da donanım belgesi istenir, P12 ile kayıt kapalıdır (yalnızca
# telefonda üretilen anahtarla, CSR ile kayıt) ve ekran kilitli dosyanın anahtarı
# her kullanımda kullanıcı onayı ister.
# Not: bu üç adı tanımayan bir sunucu sürümü onları YOK SAYAR. Derlediğin sunucu
# sürümünün notlarında (CHANGELOG, SECURE_OPERATIONS.md) geçtiklerini ve açılış
# log'unda etkin göründüklerini doğrula; geçmiyorlarsa bu üç koruma yoktur.
ENROLLMENT_ATTESTATION=enforce
ENROLLMENT_P12=off
USER_AUTH_REQUIRE_PER_USE=true

# ÜRETİM: host istemci sertifikası (bütün filonun paylaştığı tek özel anahtar)
# yalnızca cihaz host ACL'inin adını yazdığı cihazlara. Compose üretim dosyası
# true sabitler; sunucu başka değerle açılmaz. Her mTLS host için panelden ACL
# tanımla, yoksa hiçbir cihaz sertifikayı alamaz.
HOST_CLIENT_CERT_REQUIRE_GRANT=true

# ÜRETİM: cihazların ulaştığı Config API portları yalnızca cihaz uçlarını
# yanıtlar; pin yazma, host/sertifika değişikliği, probe'lar yalnızca yönetim
# portunda. Compose üretim dosyası off sabitler; sunucu başka değerle açılmaz.
CONFIG_API_ADMIN_ROUTES=off

# ÜRETİM: attestation (ATTESTATION.md). Cihaz anahtarının ilk kaydı donanım
# belgesi ister (ATTESTATION_PACKAGE_NAMES + ATTESTATION_SIGNER_SHA256 ile);
# compose üretim dosyası enforce sabitler, sunucu başka değerle açılmaz.
# Süreler ve sınırlar sunucu varsayılanı. Kendi API'n PinVault-Token'ı doğrular
# (SERVER_IMPLEMENTATION_GUIDE.md); token zorunlu olmayan uçta attestation
# reddi erişimi kesmez. Mock host'lar üretimde token ister (aşağıda).
ATTESTATION_KEY_POLICY=enforce
ATTESTATION_ENABLED=
# ÜRETİM: compose üretim dosyası production sabitler: kök, emülatör, debuggable,
# hooking, uygulama bütünlüğü ve yazılım anahtarı kodda reddedilir; panelden
# gevşetmek iki kişi onayı ister.
ATTESTATION_POLICY_DEFAULT=production
ATTESTATION_TOKEN_TTL_SECONDS=
ATTESTATION_INTERVAL_SECONDS=
ATTESTATION_NONCE_TTL_SECONDS=
ATTESTATION_REVEAL_REASONS=
ATTESTATION_RATE_LIMIT=
ATTESTATION_DEVICE_RATE_LIMIT=
# Compose üretim dosyası true sabitler: mock host'lar token'sız isteği reddeder.
MOCK_HOST_REQUIRE_TOKEN=true
# true: mock host'lar token'ın yanında istek başına PinVault-Proof da ister
# (blokta proofOfPossession()); production compose bunu sabit açar.
PINVAULT_TOKEN_REQUIRE_PROOF=
# Taze atestasyon aralığı (sn; boş/0 kapalı, önerilen 86400) ve tolerans (boş = 259200).
ATTESTATION_FRESH_INTERVAL_SECONDS=
ATTESTATION_FRESH_GRACE_SECONDS=
# Token anomalisi: off | warn | refuse (production compose: warn); sınırlar ve bayrak süresi (boş = 8 / 1200 / 600 sn / 3600 sn).
PINVAULT_TOKEN_ANOMALY=
PINVAULT_TOKEN_ANOMALY_MAX_ADDRESSES=
PINVAULT_TOKEN_ANOMALY_MAX_REQUESTS=
PINVAULT_TOKEN_ANOMALY_WINDOW_SECONDS=
ATTESTATION_ANOMALY_TTL_SECONDS=

# ─── iPhone uygulamaları (Apple App Attest) ───
# ÜRETİM: kayıt, ekran kilitli dosyanın anahtarı ve attestation yukarıda
# Android'in donanım belgesini ister; iPhone'da bu belge yoktur. Aşağıdaki
# kimlikler BOŞSA her iPhone bu üç yerde REDDEDİLİR (sunucu açılışta uyarır).
# Doluysa Apple'ın belgesi (App Attest: istek, gerçek bir Apple cihazındaki
# değiştirilmemiş uygulamadan geliyor) her yerde ayrı ayrı istenir ve Android
# belgesinin yerine geçer. Telefonun jailbreak'li olmadığını ve anahtarın
# nerede durduğunu göstermez (ATTESTATION.md §12).
# Uygulama kimlikleri: EKIPKIMLIGI.bundle.id, virgülle
# (ör. ABCDE12345.com.example.sampleclient).
APP_ATTEST_APP_IDS=
# Apple'ın kök sertifikası (container içindeki yol). Bir kez indir, data/ altına koy:
#   curl -o data/apple-app-attestation-root.pem \
#     https://www.apple.com/certificateauthority/Apple_App_Attestation_Root_CA.pem
# Kimlikler yazılıyken dosya yoksa ya da okunamıyorsa sunucu AÇILMAZ.
APP_ATTEST_ROOT_CA_FILE=/data/apple-app-attestation-root.pem
# ÜRETİM: production (App Store, TestFlight). Xcode'dan kurulan yapı
# development belgesi üretir; üretimde kabul edilmez.
APP_ATTEST_ENVIRONMENT=production
# Uygulamayı imzalayan Apple ekip kimlikleri (10 karakter, virgülle). Boş = denetlenmez.
ATTESTATION_IOS_TEAM_IDS=
# Kabul edilen en eski iOS sürümü (ör. 17.4). Boş = denetlenmez.
ATTESTATION_MIN_IOS_VERSION=

# ─── Cihaz bütünlüğü (Play Integrity) ───
# Uygulama integrityTokenProvider ile her kayıt isteğine bir bütünlük token'ı
# ekler; sunucu INTEGRITY_VERIFIER_COMMAND ile çözer. off | warn | enforce
# (boş = off). Önce warn ile gerçek bir telefonda dene, sonra enforce.
#   INTEGRITY_VERIFIER_COMMAND=/opt/pinvault/scripts/play-integrity-verify.sh
#   INTEGRITY_PLAY_PACKAGE=com.example.app
#   INTEGRITY_PLAY_SERVICE_ACCOUNT_FILE=/data/play-integrity-sa.json   (izinler 600)
INTEGRITY_VERIFICATION=
INTEGRITY_VERIFIER_COMMAND=
INTEGRITY_PLAY_PACKAGE=
INTEGRITY_PLAY_SERVICE_ACCOUNT_FILE=

# ÜRETİM: test anahtarları. Boş kalır; compose üretim dosyası ayrıca "false"
# sabitler ve sunucu bunlar true iken açılmaz. Buraya true yazmak işe yaramaz.
ALLOW_TEST_HOOKS=
ALLOW_ANONYMOUS_ADMIN=

# --- Kötüye kullanım sınırları (boş = sunucu varsayılanı) ---
# ÜRETİM: ret sınırı açık kalır (boş = 300 / 10 dk, adres başına). Cihazların
# hepsi tek bir adresin (NAT, ters vekil) arkasından geliyorsa yükselt; 0 yazma.
DEVICE_REFUSAL_RATE_LIMIT=
REPORT_RATE_LIMIT=
REPORT_DEVICE_RATE_LIMIT=
DEVICE_KEY_RATE_LIMIT=
DEVICE_KEY_LIMIT=
VAULT_MAX_FILE_BYTES=
# Aynı anda sunulan vault indirmesi, adres başına (4) ve toplam (16). Her
# indirme dosyayı bütün olarak bellekte tutar: toplam × en büyük dosya, JVM
# yığınına (HOST_MEMORY_LIMIT'in %60'ı) sığmalı.
VAULT_DOWNLOAD_CONCURRENCY=
VAULT_DOWNLOAD_CONCURRENCY_TOTAL=
MTLS_RESTART_MIN_INTERVAL_SECONDS=
ENROLLMENT_REQUEST_TTL_HOURS=
OPEN_ENROLLMENT_RATE_LIMIT=
OPEN_ENROLLMENT_MAX_PENDING=
