# sample-host — yerel ayarlar. ./scripts/setup.sh bu dosyadan .env üretir
# ve boş bıraktığın API_KEY / HOST_LAN_IP değerlerini doldurur.
#
# !!! Bu DEMO profilidir: deneme ve uçtan uca testler için. Tek paylaşılan
# yönetim anahtarı, iki kişi onayı yok, canlı sertifika kontrolü kapalı, imza
# anahtarı sunucunun diskinde. Gerçek kullanım için .env.production.example ve
# ./scripts/setup.sh --production (README → "Üretim profili").
SAMPLE_PROFILE=demo

# --- Port eşlemesi (container içi 8080/8081 sabit) ---
# Yönetim API + dashboard (düz HTTP). Varsayılan olarak yalnızca bu makineye açık;
# ağdan erişim için HOST_MANAGEMENT_TLS_PORT kullanılır. HOST_HTTP_BIND=0.0.0.0 düz
# HTTP'yi ağa açar: API anahtarı şifresiz gider, önerilmez.
HOST_HTTP_PORT=6650
HOST_HTTP_BIND=127.0.0.1
# Yönetim API'nin şifreli portu (sunucunun TLS sertifikası). Telefonlar bu porta
# bağlanmaz (raporları Config API portuna gider). Varsayılan olarak o da yalnızca
# bu makineye açık; başka makineden dashboard için HOST_MANAGEMENT_TLS_BIND=0.0.0.0.
HOST_MANAGEMENT_TLS_PORT=6655
HOST_MANAGEMENT_TLS_BIND=127.0.0.1
HOST_HTTPS_PORT=6651
# mTLS Config API (scripts/provision.sh oluşturur; istemci sertifikası zorunlu)
HOST_MTLS_PORT=6652
# Mock hedef host'lar (scripts/provision.sh oluşturur): TLS ve mTLS
HOST_MOCK_TLS_PORT=6653
HOST_MOCK_MTLS_PORT=6654
# Kurtarma kapısı: süresi dolmuş istemci sertifikası buradan yenilenir (TLS,
# istemci sertifikası istemez; yalnızca yenileme). Uygulama bu porta sunucu
# CA'sının pin'iyle bağlanır (scripts/client-config.sh yazdırır).
HOST_RECOVERY_PORT=6656

# --- Telefonların bu makineye ulaştığı LAN IP ---
# Boşsa setup.sh bulur. Sunucu TLS sertifikasının SAN listesine girer.
HOST_LAN_IP=

# --- Yönetim API anahtarı (zorunlu) ---
# Boşsa setup.sh rastgele üretir. Dashboard ilk açılışta bunu sorar.
API_KEY=

# --- demo-server kaynağı ---
# Varsayılan: upstream git. Bir tag/commit'e sabitlemek için PINVAULT_REF'i değiştir.
PINVAULT_REPO=https://github.com/umutcansu/PinVault.git
PINVAULT_REF=main
# Bu depodaki demo-server'dan derlemek için (yayınlanmamış değişiklikler dahil):
# PINVAULT_SERVER_SRC=../demo-server

# --- Örnek uygulamanın hedefi ---
# Uygulamanın pin'lediği ve bağlandığı gerçek HTTPS sitesi (client-config.sh ve
# uçtan uca testler buradan okur). En az üç parçalı bir ad olmalı
# (www.example.com gibi): joker alan adı testi *.example.com'u dener.
TARGET_HOST=www.example.com

# --- Sunucu davranışı ---
# token: cihaz kaydı admin'in ürettiği tek kullanımlık token ister (önerilen).
# open: cihaz kendi kimliğiyle (ANDROID_ID) token'sız kayıt olabilir (yalnızca demo).
# Boş = sunucu varsayılanı (token). Panelin Kurulum Sihirbazından da değişir;
# burada bir değer yazılırsa panelde sabit görünür.
ENROLLMENT_MODE=
# İmzalı config'in geçerlilik süresi (saniye).
# Boş = 86400 (1 gün). Panelden de değişir.
CONFIG_TTL_SECONDS=

# --- Parolalar (zorunlu; setup.sh boş olanları rastgele üretir) ---
# Sunucu KEYSTORE_PASSWORD, VAULT_AT_REST_PASSWORD ve (sunucudaki yerel imza
# anahtarı için) SIGNING_KEY_PASSWORD olmadan AÇILMAZ: boş bir parola, kaynak
# koddaki herkesin bildiği demo değerine düşerdi.
# İmzalama anahtarını (data/signing-key.pem) diskte AES-256-GCM ile şifreler
# (PBKDF2). Düz metin duran bir anahtar dosyası ilk açılışta şifrelenir.
SIGNING_KEY_PASSWORD=
# true: parolalar boşken sunucu kaynak koddaki demo değerleriyle açılır (yalnızca
# kullan-at denemeler). sample-host bunu kullanmaz; setup.sh parolaları üretir.
ALLOW_DEMO_SECRETS=

# --- İsteğe bağlı (boş = sunucu varsayılanı) ---
# Kayıt token'ının geçerlilik süresi (saniye, varsayılan 86400).
ENROLLMENT_TOKEN_TTL_SECONDS=
# Sunucu diskindeki vault dosyalarının (at_rest ve cihaza özel) parolası.
# setup.sh rastgele üretir. !!! BOŞ BIRAKMA: boşsa sunucu kaynak kodundaki
# SABİT demo parolasını kullanır; dosyalar şifreli görünür ama pinvault.db'yi
# ele geçiren biri hepsini açar. Değiştirirsen eskisini
# VAULT_AT_REST_PASSWORD_PREVIOUS'a yaz: sunucu açılışta dosyaları yeni parolaya
# geçirir (demo parolasıyla yazılmışları kendiliğinden). Hiçbir parolanın
# açmadığı dosya cihaza gönderilmez; yeniden yükle.
VAULT_AT_REST_PASSWORD=
VAULT_AT_REST_PASSWORD_PREVIOUS=
# "URL'den sertifika al" (host ekleme, sertifikayı URL'den yenileme): sunucu
# bağlantı yerel bilgisayar (loopback) ya da yerel ağ adresine gidiyorsa yalnızca
# bu true iken bağlanır; bulut meta veri adreslerine hiçbir zaman. DEMO: true
# (setup.sh yazar; deneme host'ları bu makinede ve LAN'da). Üretimde boş bırak.
FETCH_ALLOW_PRIVATE_TARGETS=true
# Sertifika süre uyarısı eşiği (gün, varsayılan 30).
CERT_EXPIRY_WARN_DAYS=
# Sunucunun kendi anahtar depolarının (TLS anahtarları, yedek anahtarlar, istemci
# güven listesi, host istemci sertifikaları) parolası. setup.sh rastgele üretir.
# Hiçbir cihaza gitmez. Değiştirirsen eskisini KEYSTORE_PASSWORD_PREVIOUS'a yaz:
# sunucu açılışta depoları yeni parolaya geçirir (eski varsayılan "changeit" de).
KEYSTORE_PASSWORD=
KEYSTORE_PASSWORD_PREVIOUS=
# Cihaza verilen mTLS sertifika paketinin (P12) parolası; yalnızca parola
# pazarlığı yapmayan eski kütüphane sürümleri ve elle kurulan P12 dosyaları için
# (varsayılan changeit). Güncel kütüphane her indirmede tek kullanımlık parola alır.
# DEMO: boş (changeit) kalır; önceki sürüm testi (U01) eski uygulamanın bildiği
# parolaya ihtiyaç duyar. Üretim profili rastgele bir değer üretir.
CLIENT_P12_PASSWORD=

# ─── İsteğe bağlı güvenlik katmanları (README: "İsteğe bağlı güvenlik katmanları") ───
# Hepsi boşken sunucu önceki gibi davranır. Her biri ayrı açılır.

# İmzalayıcılar: local (varsayılan, data/signing-key.pem) | pkcs11 (HSM) | command (KMS
# ya da uzak imzalayıcı). Virgülle birden çok = her config birden çok imza taşır
# (uygulamada requiredSignatures(n)). Örnek: local,local:next (anahtar döndürme sırasında).
CONFIG_SIGNERS=
# true: aynı içerik bir kez imzalanır, TTL/2 boyunca aynı imzayla sunulur; imza
# yayın anında atılır (HSM/KMS için). Yalnızca bunu bildiren istemcilere (2.1+).
CONFIG_SIGNATURE_CACHE=
# pkcs11: ./scripts/softhsm-init.sh doldurur ve açar.
PKCS11_PIN=
# command: stdin'den gelen baytları imzalayıp stdout'a imza basan komut ve public key'i.
SIGNER_COMMAND=
SIGNER_PUBLIC_KEY=
# payload | digest (AWS KMS --message-type DIGEST gibi özet imzalayanlar için)
SIGNER_INPUT=

# İmzalama anahtarı setleri: uygulamaya gömülü kurtarma public key(ler)i. Ayarlıysa
# sunucu yüklenen seti cihazın yapacağı gibi doğrular ve her config'le taşır.
# ./scripts/signing-keys.sh gen recovery-1  →  offline-keys/recovery-1.pub
RECOVERY_PUBLIC_KEYS=
RECOVERY_REQUIRED_SIGNATURES=

# Kişisel yönetici anahtarları: ad:sha256(anahtar), virgülle. ./scripts/add-admin.sh üretir.
ADMIN_KEYS=
# 2: pin/anahtar değişikliği ikinci bir yöneticinin onayını bekler (ADMIN_KEYS gerekir).
PIN_CHANGE_APPROVALS=
APPROVAL_TTL_HOURS=
# Güvenlik olayları anında bu adrese gider (Slack/Mattermost uyumlu "text" alanı).
NOTIFY_WEBHOOK_URL=
# Ayarlıysa her istek X-PinVault-Timestamp: <Unix saniye> ve
# X-PinVault-Signature: sha256=<HMAC("<zaman damgası>.<gövde>")> taşır. Alıcı
# imzayı zaman damgasıyla birlikte doğrulamalı ve eski zaman damgalarını reddetmeli.
NOTIFY_WEBHOOK_SECRET=
NOTIFY_EVENTS=

# Canlı sertifika kontrolü: off | warn | enforce. Yeni pin seti, host'un şu an sunduğu
# sertifikayı (zincirin ilk halkası) içermiyorsa enforce reddeder, warn uyarır.
PIN_LIVE_CHECK=
PIN_LIVE_CHECK_ALLOW_OVERRIDE=
# Sunucunun doğrudan çözemediği adlar için: ad=host:port;ad2=host:port
LIVE_CHECK_HOST_MAP=

# Ekran kilidiyle açılan dosyalar (user_auth): telefonun bu dosyalar için
# gönderdiği anahtarın gerçekten telefonun güvenli donanımında, kilit açılmadan
# kullanılamayacak biçimde üretildiğini Google'ın imzaladığı belgeyle
# (Android Key Attestation) doğrular.
#   off     : bakılmaz; ilk anahtar kabul, değiştirmek yalnızca yöneticiyle
#   warn    : ilk anahtar belgesiz de kabul (sonuç kaydedilir); değiştirmek
#             cihazın sertifikası/token'ı VE geçerli belge ister
#   enforce : her anahtar geçerli belge ister (paket adı + imza SHA-256'sı şart)
# DEMO: warn. Emülatörler donanım belgesi üretmez (yazılım), enforce'ta reddedilir.
USER_AUTH_ATTESTATION=
# Belgede aranacak uygulama paket adı (virgülle) ve imza sertifikası SHA-256'sı.
# DEMO: boş. İkisi birden dolu değilse hiçbir belge sayılmaz: anahtarı değişen
# cihaz için yönetici anahtarı sıfırlar (sunucu açılışta uyarır).
ATTESTATION_PACKAGE_NAMES=
ATTESTATION_SIGNER_SHA256=
# false: kilidi açık bootloader'lı / doğrulanmamış açılışlı test telefonu da geçer.
ATTESTATION_REQUIRE_VERIFIED_BOOT=
# Google'ın iptal listesinin (attestation status JSON) container içindeki yolu; boş = yok.
# Doldurursan önce ./scripts/fetch-attestation-status.sh ile indir (dosya yoksa sunucu açılmaz).
ATTESTATION_REVOKED_SERIALS_FILE=
# Liste bu kadar saatten eskiyse hiçbir belge geçmez (boş = bakılmaz; dosya gerekir).
ATTESTATION_STATUS_MAX_AGE_HOURS=
# Bu tarihten eski güvenlik yamalı telefonun belgesi geçmez (YYYYAA, ör. 202401; boş = bakılmaz).
ATTESTATION_MIN_PATCH_LEVEL=

# Kayıtta donanım belgesi (off | warn | enforce), P12 ile kayıt (off = yalnızca
# CSR) ve ekran kilitli dosyalarda her kullanımda onay. DEMO: boş (sunucu
# varsayılanı). Üretim profili enforce / off / true yazar.
ENROLLMENT_ATTESTATION=
ENROLLMENT_P12=
USER_AUTH_REQUIRE_PER_USE=

# Host istemci sertifikası (bir host'un mTLS özel anahtarı; bütün filo aynısını
# kullanır) yalnızca cihaz host ACL'inin adını yazdığı cihazlara verilsin mi?
# true (boş da true): ACL'siz bir kapsam kimseye vermez (403). DEMO: false —
# her kayıtlı cihaz mock mTLS host'unun sertifikasını alır. Üretim profili true sabitler.
HOST_CLIENT_CERT_REQUIRE_GRANT=false

# Config API portlarında (cihazların ulaştığı portlar) yönetim uçları da
# yanıtlansın mı? on: anahtarla yanıtlanır. off: yalnızca cihaz uçları; yönetim
# yalnızca yönetim portunda. DEMO: boş (on). Üretim profili off sabitler.
CONFIG_API_ADMIN_ROUTES=

# ─── Attestation: hangi uygulama örneği pin ve PinVault-Token alır (ATTESTATION.md) ───
# Boş = sunucu varsayılanı. ATTESTATION_ENABLED (true) /api/v1/attest* uçlarını
# açar. ATTESTATION_KEY_POLICY: cihaz anahtarının İLK kaydında donanım belgesi
# (off | warn | enforce; boş = warn; enforce ATTESTATION_PACKAGE_NAMES ve
# ATTESTATION_SIGNER_SHA256 ister). Üretim profili enforce yazar.
ATTESTATION_ENABLED=
ATTESTATION_KEY_POLICY=
# Politikası kaydedilmemiş Config API'nin politikası: strict (root/emülatör/
# debugger/hook/klon reddedilir) | lenient (hepsi uyarı; filo ölçülürken).
ATTESTATION_POLICY_DEFAULT=
# Token ömrü ve yeniden attestation aralığı (saniye; varsayılan 300 / 300),
# nonce ömrü (120), ret nedenleri cihaza söylensin mi (false).
ATTESTATION_TOKEN_TTL_SECONDS=
ATTESTATION_INTERVAL_SECONDS=
ATTESTATION_NONCE_TTL_SECONDS=
ATTESTATION_REVEAL_REASONS=
# 10 dakikada adres başına (60) ve cihaz başına (30) attestation; 0 = sınır yok.
ATTESTATION_RATE_LIMIT=
ATTESTATION_DEVICE_RATE_LIMIT=
# true: mock host'lar geçerli PinVault-Token olmadan isteği reddeder (uygulamanın
# kendi API'si gibi). DEMO: boş (false).
MOCK_HOST_REQUIRE_TOKEN=
# Boş ya da true: mock host'lar token'ın yanında istek başına PinVault-Proof da
# ister (blokta proofOfPossession()); false kapatır. Production compose true sabitler.
PINVAULT_TOKEN_REQUIRE_PROOF=
# PinVault-Token imzası. Boş ya da ES256: token'ı yalnızca sunucudaki özel anahtar
# imzalar, API'ler açık anahtarla doğrular (/api/v1/attestation/jwks). HS256: imzalayan
# ve doğrulayan aynı ortak sır (henüz geçmemiş API'ler için). Üretim ES256 sabitler.
PINVAULT_TOKEN_ALG=
# Mock host'ların kabul ettiği Config API kimlikleri (token'ın aud'u), virgülle. Boş = bu
# sunucunun çalışan bütün Config API'leri.
MOCK_HOST_TOKEN_AUDIENCES=
# Taze atestasyon aralığı (sn; boş/0 kapalı, önerilen 86400) ve tolerans (boş = 259200).
ATTESTATION_FRESH_INTERVAL_SECONDS=
ATTESTATION_FRESH_GRACE_SECONDS=
# Token anomalisi: off | warn | refuse (production compose: warn); sınırlar ve bayrak süresi (boş = 8 / 1200 / 600 sn / 3600 sn).
PINVAULT_TOKEN_ANOMALY=
PINVAULT_TOKEN_ANOMALY_MAX_ADDRESSES=
PINVAULT_TOKEN_ANOMALY_MAX_REQUESTS=
PINVAULT_TOKEN_ANOMALY_WINDOW_SECONDS=
ATTESTATION_ANOMALY_TTL_SECONDS=

# ─── Cihaz bütünlüğü (Play Integrity) ───
# Uygulama integrityTokenProvider ile her kayıt isteğine bir bütünlük token'ı
# ekler; sunucu INTEGRITY_VERIFIER_COMMAND ile çözer. off | warn | enforce
# (boş = off). Önce warn ile gerçek bir telefonda dene, sonra enforce.
#   INTEGRITY_VERIFIER_COMMAND=/opt/pinvault/scripts/play-integrity-verify.sh
#   INTEGRITY_PLAY_PACKAGE=com.example.app
#   INTEGRITY_PLAY_SERVICE_ACCOUNT_FILE=/data/play-integrity-sa.json   (izinler 600)
INTEGRITY_VERIFICATION=
INTEGRITY_VERIFIER_COMMAND=
INTEGRITY_PLAY_PACKAGE=
INTEGRITY_PLAY_SERVICE_ACCOUNT_FILE=

# ─── Kötüye kullanım sınırları (boş = sunucu varsayılanı) ───
# Bir adresin 10 dakikada toplayabileceği reddedilen istek sayısı (sunucu
# varsayılanı 300). DEMO: 0 = sınır yok. Docker Desktop arkasında bütün cihazlar
# sunucuya tek adresten görünür ve uçtan uca testler bilerek çok sayıda
# reddedilen istek yapar. ÜRETİMDE 0 YAZMA.
DEVICE_REFUSAL_RATE_LIMIT=0
# Cihaz raporları: adres başına ve cihaz başına sınır.
REPORT_RATE_LIMIT=
REPORT_DEVICE_RATE_LIMIT=
# Cihaz anahtarı kaydı: adres başına yazma sınırı ve kapsam başına toplam.
DEVICE_KEY_RATE_LIMIT=
DEVICE_KEY_LIMIT=
# Vault dosyasının en büyük boyutu (bayt).
VAULT_MAX_FILE_BYTES=
# Aynı anda sunulan vault indirmesi: adres başına (varsayılan 4) ve toplam
# (varsayılan 16). Her indirme dosyayı bütün olarak bellekte tutar; toplamı
# yükseltirken HOST_MEMORY_LIMIT'i de yükselt.
VAULT_DOWNLOAD_CONCURRENCY=
VAULT_DOWNLOAD_CONCURRENCY_TOTAL=
# mTLS dinleyicilerinin en sık yeniden başlatılma aralığı (saniye).
MTLS_RESTART_MIN_INTERVAL_SECONDS=
