# sample-host — yerel ayarlar. ./scripts/setup.sh bu dosyadan .env üretir
# ve boş bıraktığın API_KEY / HOST_LAN_IP değerlerini doldurur.

# --- Port eşlemesi (container içi 8080/8081 sabit) ---
# Yönetim API + dashboard (düz HTTP). Varsayılan olarak yalnızca bu makineye açık;
# ağdan erişim için HOST_MANAGEMENT_TLS_PORT kullanılır. HOST_HTTP_BIND=0.0.0.0 düz
# HTTP'yi ağa açar: API anahtarı şifresiz gider, önerilmez.
HOST_HTTP_PORT=6650
HOST_HTTP_BIND=127.0.0.1
# Yönetim API'nin şifreli portu (sunucunun TLS sertifikası): telefonların raporları
# ve başka makineden dashboard buradan.
HOST_MANAGEMENT_TLS_PORT=6655
HOST_HTTPS_PORT=6651
# mTLS Config API (scripts/provision.sh oluşturur; istemci sertifikası zorunlu)
HOST_MTLS_PORT=6652
# Mock hedef host'lar (scripts/provision.sh oluşturur): TLS ve mTLS
HOST_MOCK_TLS_PORT=6653
HOST_MOCK_MTLS_PORT=6654
# Kurtarma kapısı: süresi dolmuş istemci sertifikası buradan yenilenir (TLS,
# istemci sertifikası istemez; yalnızca yenileme). Uygulama bu porta sunucu
# CA'sının pin'iyle bağlanır (scripts/client-config.sh yazdırır).
HOST_RECOVERY_PORT=6656

# --- Telefonların bu makineye ulaştığı LAN IP ---
# Boşsa setup.sh bulur. Sunucu TLS sertifikasının SAN listesine girer.
HOST_LAN_IP=

# --- Yönetim API anahtarı (zorunlu) ---
# Boşsa setup.sh rastgele üretir. Dashboard ilk açılışta bunu sorar.
API_KEY=

# --- demo-server kaynağı ---
# Varsayılan: upstream git. Bir tag/commit'e sabitlemek için PINVAULT_REF'i değiştir.
PINVAULT_REPO=https://github.com/umutcansu/PinVault.git
PINVAULT_REF=main
# Bu depodaki demo-server'dan derlemek için (yayınlanmamış değişiklikler dahil):
# PINVAULT_SERVER_SRC=../demo-server

# --- Örnek uygulamanın hedefi ---
# Uygulamanın pin'lediği ve bağlandığı gerçek HTTPS sitesi (client-config.sh ve
# uçtan uca testler buradan okur). En az üç parçalı bir ad olmalı
# (www.example.com gibi): joker alan adı testi *.example.com'u dener.
TARGET_HOST=www.example.com

# --- Sunucu davranışı ---
# token: cihaz kaydı admin'in ürettiği tek kullanımlık token ister (önerilen).
# open: cihaz kendi kimliğiyle (ANDROID_ID) token'sız kayıt olabilir (yalnızca demo).
ENROLLMENT_MODE=token
# İmzalı config'in geçerlilik süresi (saniye).
CONFIG_TTL_SECONDS=86400

# --- İsteğe bağlı (boş = sunucu varsayılanı) ---
# İmzalama anahtarını diskte AES-256-GCM ile şifreler (PBKDF2). Üretimde ayarla.
SIGNING_KEY_PASSWORD=
# Kayıt token'ının geçerlilik süresi (saniye, varsayılan 86400).
ENROLLMENT_TOKEN_TTL_SECONDS=
# Sunucu diskindeki vault dosyalarının (at_rest ve cihaza özel) parolası.
# setup.sh rastgele üretir. !!! BOŞ BIRAKMA: boşsa sunucu kaynak kodundaki
# SABİT demo parolasını kullanır; dosyalar şifreli görünür ama pinvault.db'yi
# ele geçiren biri hepsini açar. Değiştirirsen eskisini
# VAULT_AT_REST_PASSWORD_PREVIOUS'a yaz: sunucu açılışta dosyaları yeni parolaya
# geçirir (demo parolasıyla yazılmışları kendiliğinden). Hiçbir parolanın
# açmadığı dosya cihaza gönderilmez; yeniden yükle.
VAULT_AT_REST_PASSWORD=
VAULT_AT_REST_PASSWORD_PREVIOUS=
# Sertifika süre uyarısı eşiği (gün, varsayılan 30).
CERT_EXPIRY_WARN_DAYS=
# Sunucunun kendi anahtar depolarının (TLS anahtarları, yedek anahtarlar, istemci
# güven listesi, host istemci sertifikaları) parolası. setup.sh rastgele üretir.
# Hiçbir cihaza gitmez. Değiştirirsen eskisini KEYSTORE_PASSWORD_PREVIOUS'a yaz:
# sunucu açılışta depoları yeni parolaya geçirir (eski varsayılan "changeit" de).
KEYSTORE_PASSWORD=
KEYSTORE_PASSWORD_PREVIOUS=
# Cihaza verilen mTLS sertifika paketinin (P12) parolası; yalnızca parola
# pazarlığı yapmayan eski kütüphane sürümleri ve elle kurulan P12 dosyaları için
# (varsayılan changeit). Güncel kütüphane her indirmede tek kullanımlık parola alır.
CLIENT_P12_PASSWORD=

# ─── İsteğe bağlı güvenlik katmanları (README: "İsteğe bağlı güvenlik katmanları") ───
# Hepsi boşken sunucu önceki gibi davranır. Her biri ayrı açılır.

# İmzalayıcılar: local (varsayılan, data/signing-key.pem) | pkcs11 (HSM) | command (KMS
# ya da uzak imzalayıcı). Virgülle birden çok = her config birden çok imza taşır
# (uygulamada requiredSignatures(n)). Örnek: local,local:next (anahtar döndürme sırasında).
CONFIG_SIGNERS=
# true: aynı içerik bir kez imzalanır, TTL/2 boyunca aynı imzayla sunulur; imza
# yayın anında atılır (HSM/KMS için). Yalnızca bunu bildiren istemcilere (2.1+).
CONFIG_SIGNATURE_CACHE=
# pkcs11: ./scripts/softhsm-init.sh doldurur ve açar.
PKCS11_PIN=
# command: stdin'den gelen baytları imzalayıp stdout'a imza basan komut ve public key'i.
SIGNER_COMMAND=
SIGNER_PUBLIC_KEY=
# payload | digest (AWS KMS --message-type DIGEST gibi özet imzalayanlar için)
SIGNER_INPUT=

# İmzalama anahtarı setleri: uygulamaya gömülü kurtarma public key(ler)i. Ayarlıysa
# sunucu yüklenen seti cihazın yapacağı gibi doğrular ve her config'le taşır.
# ./scripts/signing-keys.sh gen recovery-1  →  offline-keys/recovery-1.pub
RECOVERY_PUBLIC_KEYS=
RECOVERY_REQUIRED_SIGNATURES=

# Kişisel yönetici anahtarları: ad:sha256(anahtar), virgülle. ./scripts/add-admin.sh üretir.
ADMIN_KEYS=
# 2: pin/anahtar değişikliği ikinci bir yöneticinin onayını bekler (ADMIN_KEYS gerekir).
PIN_CHANGE_APPROVALS=
APPROVAL_TTL_HOURS=
# Güvenlik olayları anında bu adrese gider (Slack/Mattermost uyumlu "text" alanı).
NOTIFY_WEBHOOK_URL=
# Ayarlıysa her istek X-PinVault-Signature: sha256=<HMAC> taşır.
NOTIFY_WEBHOOK_SECRET=
NOTIFY_EVENTS=

# Canlı sertifika kontrolü: off | warn | enforce. Yeni pin seti, host'un şu an sunduğu
# sertifikayı (zincirin ilk halkası) içermiyorsa enforce reddeder, warn uyarır.
PIN_LIVE_CHECK=
PIN_LIVE_CHECK_ALLOW_OVERRIDE=
# Sunucunun doğrudan çözemediği adlar için: ad=host:port;ad2=host:port
LIVE_CHECK_HOST_MAP=
